{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/safety_gate.py\" || exit 2",
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
