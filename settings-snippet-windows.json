{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["C:/Users/YOUR-WINDOWS-USERNAME/.claude/hooks/safety_gate.py"],
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
